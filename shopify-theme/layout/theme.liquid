<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- if template.name == 'index' -%}
    <title>Alves Renovation | General Contractor in PA, NJ &amp; DE &mdash; Residential &amp; Commercial</title>
    <meta name="description" content="Alves Renovation is a licensed &amp; insured general contractor for residential and commercial projects in Pennsylvania, New Jersey and Delaware: bathroom remodeling, custom stair capping, flooring, stucco &amp; exterior, drywall, painting, framing &amp; trim and pressure washing. Free on-site estimates.">
  {%- else -%}
    <title>{{ page_title }} in PA, NJ &amp; DE | Alves Renovation</title>
    {%- if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif -%}
  {%- endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  <meta property="og:site_name" content="Alves Renovation">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{% if template.name == 'index' %}Alves Renovation | Quality &bull; Precision &bull; Trust{% else %}{{ page_title | escape }} | Alves Renovation{% endif %}">
  <meta property="og:type" content="website">
  {%- assign og = images['alves-logo-full.jpg'] -%}
  {%- if og %}<meta property="og:image" content="https:{{ og | image_url: width: 1200 }}">{% endif %}
  <meta name="theme-color" content="#0E0E10">
  {%- assign fav = images['alves-favicon.png'] -%}
  {%- if fav %}<link rel="icon" type="image/png" href="{{ fav | image_url: width: 64 }}">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet">
  {{ 'alves.css' | asset_url | stylesheet_tag }}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "GeneralContractor",
    "name": "Alves Renovation",
    "url": "{{ shop.url }}",
    "telephone": "+1-267-616-0381",
    "email": "alvesrenovationus@gmail.com",
    "areaServed": [
      { "@type": "State", "name": "Pennsylvania" },
      { "@type": "State", "name": "New Jersey" },
      { "@type": "State", "name": "Delaware" }
    ],
    "sameAs": ["https://www.instagram.com/alves_renovationllc/"]
  }
  </script>
  {{ content_for_header }}
</head>
<body>
  {% sections 'alves-header-group' %}
  <main id="MainContent">
    {{ content_for_layout }}
  </main>
  {% sections 'alves-footer-group' %}
  <script src="{{ 'alves.js' | asset_url }}" defer></script>
</body>
</html>
