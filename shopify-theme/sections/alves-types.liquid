<section class="section section--alt">
  <div class="container">
    <header class="section__head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </header>
    <div class="type-cards">{%- for block in section.blocks -%}<article class="type-card" {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></article>{%- endfor -%}</div>
  </div>
</section>

{% schema %}
{"name": "Alves option cards", "settings": [{"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Options"}, {"type": "text", "id": "heading", "label": "Heading"}, {"type": "text", "id": "subheading", "label": "Subheading"}], "blocks": [{"type": "card", "name": "Card", "settings": [{"type": "text", "id": "title", "label": "Title"}, {"type": "text", "id": "text", "label": "Text"}]}], "presets": [{"name": "Alves option cards"}]}
{% endschema %}
