{%- assign first = section.blocks.first -%}
<section class="section section--dark" id="before-after">
  <div class="container">
    <header class="section__head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </header>
    <div class="ba-tabs" role="tablist">
      {%- for block in section.blocks -%}
        <button class="ba-tab{% if forloop.first %} is-active{% endif %}" role="tab" {{ block.shopify_attributes }}
          data-before="{{ block.settings.before | image_url: width: 1200 }}" data-after="{{ block.settings.after | image_url: width: 1200 }}"
          data-title="{{ block.settings.title | escape }}" data-text="{{ block.settings.text | escape }}">{{ block.settings.tab }}</button>
      {%- endfor -%}
    </div>
    {%- if first -%}
    <div class="ba-stage">
      <div class="ba" id="ba">
            <img class="ba__img ba__after" src="{{ first.settings.after | image_url: width: 1200 }}" alt="After: {{ first.settings.title | escape }}" />
            <div class="ba__before-wrap"><img class="ba__img ba__before" src="{{ first.settings.before | image_url: width: 1200 }}" alt="Before: {{ first.settings.title | escape }}" /></div>
            <button type="button" class="ba__label ba__label--before" aria-label="Show full before photo">Before</button>
            <button type="button" class="ba__label ba__label--after" aria-label="Show full after photo">After</button>
            <div class="ba__handle" aria-hidden="true"><span></span></div>
            <input class="ba__range" type="range" min="0" max="100" step="1" value="50" aria-label="Before and after comparison slider" />
          </div>
      <div class="ba-info">
        <h3 id="baTitle">{{ first.settings.title }}</h3>
        <p id="baText">{{ first.settings.text }}</p>
        <a href="{{ section.settings.btn_link }}" class="btn btn--primary">{{ section.settings.btn_label }}</a>
      </div>
    </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{"name": "Alves before & after", "settings": [{"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real projects"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Before & After"}, {"type": "text", "id": "subheading", "label": "Subheading", "default": "Drag across the photo to compare — or tap Before / After to see each one in full."}, {"type": "text", "id": "btn_label", "label": "Button label", "default": "I want this for my home"}, {"type": "text", "id": "btn_link", "label": "Button link", "default": "#quote"}], "blocks": [{"type": "project", "name": "Project", "settings": [{"type": "text", "id": "tab", "label": "Tab label", "default": "Project"}, {"type": "text", "id": "title", "label": "Title", "default": "Project"}, {"type": "textarea", "id": "text", "label": "Description"}, {"type": "image_picker", "id": "before", "label": "Before photo"}, {"type": "image_picker", "id": "after", "label": "After photo"}]}], "max_blocks": 8, "presets": [{"name": "Alves before & after"}]}
{% endschema %}
