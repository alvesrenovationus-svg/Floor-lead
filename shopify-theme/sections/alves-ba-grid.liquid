<section class="section section--dark">
  <div class="container">
    <header class="section__head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </header>
    <div class="sp-ba-grid{% if section.blocks.size == 1 %} sp-ba-grid--single{% endif %}">
      {%- for block in section.blocks -%}
        <div class="sp-ba" {{ block.shopify_attributes }}>
          <div class="ba">
            <img class="ba__img ba__after" src="{{ block.settings.after | image_url: width: 1200 }}" alt="After: {{ block.settings.title | escape }}" loading="lazy" />
            <div class="ba__before-wrap"><img class="ba__img ba__before" src="{{ block.settings.before | image_url: width: 1200 }}" alt="Before: {{ block.settings.title | escape }}" loading="lazy" /></div>
            <button type="button" class="ba__label ba__label--before" aria-label="Show full before photo">Before</button>
            <button type="button" class="ba__label ba__label--after" aria-label="Show full after photo">After</button>
            <div class="ba__handle" aria-hidden="true"><span></span></div>
            <input class="ba__range" type="range" min="0" max="100" step="1" value="50" aria-label="Before and after comparison slider" />
          </div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{"name": "Alves before & after grid", "settings": [{"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real projects"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Before & After"}, {"type": "text", "id": "subheading", "label": "Subheading", "default": "Drag across the photo to compare — or tap Before / After to see each one in full."}], "blocks": [{"type": "project", "name": "Project", "settings": [{"type": "text", "id": "tab", "label": "Tab label", "default": "Project"}, {"type": "text", "id": "title", "label": "Title", "default": "Project"}, {"type": "textarea", "id": "text", "label": "Description"}, {"type": "image_picker", "id": "before", "label": "Before photo"}, {"type": "image_picker", "id": "after", "label": "After photo"}]}], "max_blocks": 6, "presets": [{"name": "Alves before & after grid"}]}
{% endschema %}
