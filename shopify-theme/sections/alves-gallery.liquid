<section class="section" id="gallery">
  <div class="container">
    <header class="section__head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </header>
    <div class="carousel" id="carousel">
      <button class="carousel__btn carousel__btn--prev" aria-label="Previous photo">&#10094;</button>
      <div class="carousel__track">
        {%- for block in section.blocks -%}<figure class="slide" {{ block.shopify_attributes }}>{%- if block.settings.image -%}<img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.caption | strip_html | escape }}" loading="lazy" />{%- endif -%}<figcaption>{{ block.settings.caption }}</figcaption></figure>{%- endfor -%}
      </div>
      <button class="carousel__btn carousel__btn--next" aria-label="Next photo">&#10095;</button>
      <div class="carousel__dots" aria-hidden="true"></div>
    </div>
  </div>
</section>

{% schema %}
{"name": "Alves gallery", "settings": [{"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Portfolio"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Recent Work"}], "blocks": [{"type": "photo", "name": "Photo", "settings": [{"type": "image_picker", "id": "image", "label": "Photo"}, {"type": "text", "id": "caption", "label": "Caption"}]}], "max_blocks": 30, "presets": [{"name": "Alves gallery"}]}
{% endschema %}
