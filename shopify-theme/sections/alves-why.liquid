<section class="section section--alt" id="why">
  <div class="container">
    <header class="section__head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </header>
    <div class="values">
        {%- for block in section.blocks -%}{%- if block.type == 'value' -%}
        <article class="value" {{ block.shopify_attributes }}><div class="value__icon">{%- case block.settings.icon -%}{%- when 'diamond' -%}&#9671;{%- when 'check' -%}&#10003;{%- else -%}&#9733;{%- endcase -%}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></article>
        {%- endif -%}{%- endfor -%}
      </div>
  </div>
  <div class="container why">
    <div class="why__photo">{%- if section.settings.photo -%}<img src="{{ section.settings.photo | image_url: width: 1000 }}" alt="{{ section.settings.title | strip_html | escape }}" loading="lazy" />{%- endif -%}</div>
    <div class="why__copy">
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.text }}</p>
      <ul class="qualities">
        {%- for block in section.blocks -%}{%- if block.type == 'quality' -%}<li {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></li>{%- endif -%}{%- endfor -%}
      </ul>
      <ol class="steps">
        {%- for block in section.blocks -%}{%- if block.type == 'step' -%}<li {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></li>{%- endif -%}{%- endfor -%}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{"name": "Alves why us", "settings": [{"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Alves Renovation"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Quality • Precision • Trust"}, {"type": "text", "id": "subheading", "label": "Subheading"}, {"type": "image_picker", "id": "photo", "label": "Photo"}, {"type": "text", "id": "title", "label": "Title", "default": "One general contractor for the whole project"}, {"type": "textarea", "id": "text", "label": "Text"}], "blocks": [{"type": "value", "name": "Value card", "settings": [{"type": "select", "id": "icon", "label": "Icon", "default": "star", "options": [{"value": "star", "label": "Star"}, {"value": "diamond", "label": "Diamond"}, {"value": "check", "label": "Check"}]}, {"type": "text", "id": "title", "label": "Title", "default": "Quality"}, {"type": "text", "id": "text", "label": "Text"}]}, {"type": "quality", "name": "Quality", "settings": [{"type": "text", "id": "title", "label": "Title", "default": "Quality"}, {"type": "text", "id": "text", "label": "Text"}]}, {"type": "step", "name": "Process step", "settings": [{"type": "text", "id": "title", "label": "Title", "default": "Step"}, {"type": "text", "id": "text", "label": "Text"}]}], "presets": [{"name": "Alves why us"}]}
{% endschema %}
