<section class="sp-hero">
  <div class="sp-hero__bg" aria-hidden="true">{%- if section.settings.image -%}<img src="{{ section.settings.image | image_url: width: 1800 }}" alt="" />{%- endif -%}</div>
  <div class="container sp-hero__inner">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> <span>/</span>{% if section.settings.show_services_crumb %} <a href="/#services">Services</a> <span>/</span>{% endif %} <b>{{ section.settings.heading }} {{ section.settings.heading_accent }}</b></nav>
    {%- assign kparts = section.settings.kicker | split: '|' -%}
    <p class="hero__kicker">{%- for k in kparts -%}<span>{{ k | strip }}</span>{% unless forloop.last %} <i>&bull;</i> {% endunless %}{%- endfor -%}</p>
    <h1>{{ section.settings.heading }} <span class="accent">{{ section.settings.heading_accent }}</span></h1>
    <p class="lead">{{ section.settings.lead }}</p>
    <div class="hero__ctas">
      <a href="#quote" class="btn btn--primary btn--lg">{{ section.settings.btn1_label }}</a>
      <a href="tel:{{ section.settings.phone }}" class="btn btn--outline btn--lg">{{ section.settings.btn2_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{"name": "Alves page hero", "settings": [{"type": "image_picker", "id": "image", "label": "Background image"}, {"type": "text", "id": "kicker", "label": "Kicker (separate with |)", "default": "Licensed & Insured | Residential & Commercial | Serving PA • NJ • DE"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Service"}, {"type": "text", "id": "heading_accent", "label": "Heading (gold)"}, {"type": "textarea", "id": "lead", "label": "Intro"}, {"type": "text", "id": "btn1_label", "label": "Button 1 label", "default": "Get My Free Estimate"}, {"type": "text", "id": "btn2_label", "label": "Button 2 label", "default": "Call (267) 616-0381"}, {"type": "text", "id": "phone", "label": "Phone (for calling)", "default": "+12676160381"}, {"type": "checkbox", "id": "show_services_crumb", "label": "Show \"Services\" in breadcrumb", "default": true}], "presets": [{"name": "Alves page hero"}]}
{% endschema %}
