<section class="sp-hero">
  <div class="container sp-hero__inner">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> <span>/</span> <b>{{ page_title }}</b></nav>
    <h1>{{ page_title }}</h1>
  </div>
</section>
<section class="section">
  <div class="container rte" style="max-width:820px">
    {%- case template.name -%}
      {%- when 'page' -%}{{ page.content }}
      {%- when 'article' -%}{{ article.content }}
      {%- when 'blog' -%}{%- for a in blog.articles -%}<h2><a href="{{ a.url }}">{{ a.title }}</a></h2><p>{{ a.excerpt_or_content | strip_html | truncatewords: 40 }}</p>{%- endfor -%}
      {%- when 'product' -%}<p>{{ product.description }}</p>
      {%- when 'search' -%}{%- if search.performed -%}{%- for r in search.results -%}<p><a href="{{ r.url }}">{{ r.title }}</a></p>{%- else -%}<p>No results.</p>{%- endfor -%}{%- endif -%}
      {%- when 'password' -%}<p>{{ shop.password_message }}</p>{%- form 'storefront_password' -%}{{ form.errors | default_errors }}<div class="lead-form" style="display:flex;gap:10px;max-width:420px"><input type="password" name="password" placeholder="Password" aria-label="Password"><button class="btn btn--primary" type="submit">Enter</button></div>{%- endform -%}
      {%- else -%}<p>{{ section.settings.text }}</p>
    {%- endcase -%}
    <p style="margin-top:32px"><a class="btn btn--primary" href="/#quote">{{ section.settings.button }}</a> <a class="btn btn--outline" href="/">Home</a></p>
  </div>
</section>
{% schema %}
{"name": "Alves page content", "settings": [{"type": "text", "id": "text", "label": "Text", "default": "Looking for a renovation? Request a free on-site estimate."}, {"type": "text", "id": "button", "label": "Button label", "default": "Get a Free Estimate"}], "presets": [{"name": "Alves page content"}]}
{% endschema %}
