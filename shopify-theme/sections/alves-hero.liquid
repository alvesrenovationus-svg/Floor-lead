<section class="hero">
  <div class="hero__bg" aria-hidden="true">{%- if section.settings.bg_image -%}<img src="{{ section.settings.bg_image | image_url: width: 1800 }}" alt="" />{%- endif -%}</div>
  <div class="container hero__grid">
    <div class="hero__copy">
      {%- assign logo = section.settings.logo | default: images['alves-logo.png'] -%}
      {%- if logo %}<img src="{{ logo | image_url: width: 300 }}" alt="Alves Renovation — Quality, Precision, Trust" class="hero__logo" width="110" height="110" />{% endif %}
      {%- if section.settings.badge != blank %}<span class="badge-li">&#9733; {{ section.settings.badge }}</span>{% endif %}
      {%- if section.settings.pill != blank %}<span class="pill">{{ section.settings.pill }}</span>{% endif %}
      {%- if section.settings.kicker != blank -%}
        {%- assign kparts = section.settings.kicker | split: '|' -%}
        <p class="hero__kicker">{%- for k in kparts -%}<span>{{ k | strip }}</span>{% unless forloop.last %} <i>&bull;</i> {% endunless %}{%- endfor -%}</p>
      {%- endif %}
      <h1>{{ section.settings.heading }}<br /><span class="accent">{{ section.settings.heading_accent }}</span></h1>
      <div class="lead">{{ section.settings.lead }}</div>
      {%- assign checks = section.settings.checks | newline_to_br | split: '<br />' -%}
      <ul class="hero__checks">{%- for c in checks -%}{%- assign cs = c | strip -%}{%- if cs != blank -%}<li>{{ cs }}</li>{%- endif -%}{%- endfor -%}</ul>
      <div class="hero__ctas">
        <a href="{{ section.settings.btn1_link }}" class="btn btn--primary btn--lg">{{ section.settings.btn1_label }}</a>
        <a href="{{ section.settings.btn2_link }}" class="btn btn--outline btn--lg">{{ section.settings.btn2_label }}</a>
      </div>
    </div>
    <div class="hero-slider" id="heroSlider" aria-roledescription="carousel" aria-label="Our work">
      {%- for block in section.blocks -%}
        <figure class="hero-slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}<img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.caption | escape }}"{% unless forloop.first %} loading="lazy"{% endunless %} />{%- endif -%}
          <figcaption>{{ block.settings.caption }}</figcaption>
        </figure>
      {%- endfor -%}
      <button class="hero-slider__btn hero-slider__btn--prev" aria-label="Previous photo">&#10094;</button>
      <button class="hero-slider__btn hero-slider__btn--next" aria-label="Next photo">&#10095;</button>
      <div class="hero-slider__dots" aria-hidden="true"></div>
    </div>
  </div>
</section>

{% schema %}
{"name": "Alves hero", "settings": [{"type": "image_picker", "id": "bg_image", "label": "Background image"}, {"type": "image_picker", "id": "logo", "label": "Logo"}, {"type": "text", "id": "badge", "label": "Badge", "default": "Licensed & Insured"}, {"type": "text", "id": "pill", "label": "Tagline pill", "default": "Quality • Precision • Trust"}, {"type": "text", "id": "kicker", "label": "Kicker (separate items with |)", "default": "General Contractor | Residential & Commercial | Serving PA • NJ • DE"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Renovations"}, {"type": "text", "id": "heading_accent", "label": "Heading (gold)", "default": "done right."}, {"type": "richtext", "id": "lead", "label": "Intro text", "default": "<p>Your licensed general contractor for bathroom remodeling, custom stair capping, flooring, stucco & exterior repair and more.</p>"}, {"type": "textarea", "id": "checks", "label": "Checklist (one per line)", "default": "Licensed & insured\nResidential & commercial\nInterior & exterior\nClean, precise work"}, {"type": "text", "id": "btn1_label", "label": "Button 1 label", "default": "Get My Free Quote"}, {"type": "text", "id": "btn1_link", "label": "Button 1 link", "default": "#quote"}, {"type": "text", "id": "btn2_label", "label": "Button 2 label", "default": "See Our Work"}, {"type": "text", "id": "btn2_link", "label": "Button 2 link", "default": "#before-after"}], "blocks": [{"type": "slide", "name": "Slide", "settings": [{"type": "image_picker", "id": "image", "label": "Photo"}, {"type": "text", "id": "caption", "label": "Caption", "default": "Recent project"}]}], "max_blocks": 12, "presets": [{"name": "Alves hero"}]}
{% endschema %}
