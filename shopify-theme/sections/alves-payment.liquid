{%- capture pay_badges -%}
  {%- assign pay_types = shop.enabled_payment_types -%}
  {%- if pay_types.size == 0 -%}{%- assign pay_types = 'visa,master,american_express,discover,apple_pay,google_pay,shopify_pay' | split: ',' -%}{%- endif -%}
  <ul class="pay-badges" aria-label="Accepted payment methods">{%- for type in pay_types -%}<li>{{ type | payment_type_svg_tag: class: 'pay-badges__icon' }}</li>{%- endfor -%}</ul>
{%- endcapture -%}
{%- assign pay_product = section.settings.product | default: all_products['invoice-payment'] -%}
{%- assign pay_variant = pay_product.variants | where: 'title', 'Invoice payment' | first | default: pay_product.selected_or_first_available_variant -%}
{%- assign pay_cents = pay_product.variants | where: 'title', 'Cents' | first -%}
{%- assign tip_product = section.settings.tip_product | default: all_products['tip'] -%}
{%- assign tip_variant = tip_product.variants | where: 'title', 'Tip' | first | default: tip_product.selected_or_first_available_variant -%}
{%- assign tip_cents = tip_product.variants | where: 'title', 'Cents' | first -%}
<section class="section" id="pay">
  <div class="container pay pay--stacked">
    <div class="pay__copy">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <ol class="pay__steps">
        {%- assign steps = section.settings.steps | newline_to_br | split: '<br />' -%}
        {%- for s in steps -%}{%- assign ss = s | strip -%}{%- if ss != blank -%}<li>{{ ss }}</li>{%- endif -%}{%- endfor -%}
      </ol>
    </div>

    {%- if pay_variant -%}
    <form class="quote__form js-quickpay pay__form" novalidate data-pay-variant="{{ pay_variant.id }}"{% if pay_cents %} data-pay-cents="{{ pay_cents.id }}"{% endif %}{% if section.settings.show_tips and tip_product %} data-tip-variant="{{ tip_variant.id }}"{% if tip_cents %} data-tip-cents="{{ tip_cents.id }}"{% endif %}{% endif %}>
      <label class="quickpay__label" for="qp-amount">Amount to pay</label>
      <div class="quickpay__amount"><span>$</span><input id="qp-amount" type="text" inputmode="decimal" placeholder="0.00" autocomplete="off" required></div>

      <label class="quickpay__label" for="qp-invoice">Invoice # <em>(optional)</em></label>
      <input id="qp-invoice" class="quickpay__input" type="text" placeholder="e.g. 1024" autocomplete="off">

      {%- if section.settings.show_tips and tip_product -%}
      <span class="quickpay__label">Tip for the crew <em>(optional)</em></span>
      <div class="quickpay__tips" role="radiogroup" aria-label="Tip">
        <label><input type="radio" name="qp-tip" value="0" checked><span>No tip</span></label>
        {%- assign tip_opts = section.settings.tip_options | split: ',' -%}
        {%- for t in tip_opts -%}{%- assign ts = t | strip -%}{%- if ts != blank -%}<label><input type="radio" name="qp-tip" value="{{ ts }}"><span>{{ ts }}%</span></label>{%- endif -%}{%- endfor -%}
      </div>
      {%- endif -%}

      <button type="submit" class="btn btn--primary btn--lg btn--block quickpay__btn"><span data-qp-label>{{ section.settings.button_label }}</span> &rarr;</button>
      <p class="form-status" role="status" aria-live="polite"></p>
      <div class="pay-secure-line"><span>&#128274; {{ section.settings.button_note }}</span></div>
      <p class="fineprint">{{ section.settings.fineprint }}</p>
    </form>
    {%- else -%}
    <div class="quote__form"><p>{{ section.settings.unavailable_text }}</p><a class="btn btn--primary" href="/pages/contact">Contact us</a></div>
    {%- endif -%}

    <div class="pay-trust">
        <p class="pay-trust__title">{{ section.settings.trust_title }}</p>
        {{ pay_badges }}
        <ul class="pay-trust__list">
          {%- assign titems = section.settings.trust_items | newline_to_br | split: '<br />' -%}
          {%- for ti in titems -%}{%- assign tparts = ti | strip | split: '|' -%}{%- if tparts.size > 0 and tparts[0] != blank -%}
          <li><span class="pay-trust__icon" aria-hidden="true">{%- case forloop.index -%}{%- when 1 -%}<svg viewBox="0 0 24 24"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Zm-1 14-4-4 1.4-1.4L11 13.2l4.6-4.6L17 10l-6 6Z"/></svg>{%- when 2 -%}<svg viewBox="0 0 24 24"><path d="M17 9V7a5 5 0 0 0-10 0v2H5v13h14V9h-2Zm-8-2a3 3 0 0 1 6 0v2H9V7Zm4 10.7V19h-2v-1.3a2 2 0 1 1 2 0Z"/></svg>{%- else -%}<svg viewBox="0 0 24 24"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"/></svg>{%- endcase -%}</span><span><strong>{{ tparts[0] | strip }}</strong>{%- if tparts[1] -%}<small>{{ tparts[1] | strip }}</small>{%- endif -%}</span></li>
          {%- endif -%}{%- endfor -%}
        </ul>
        <p class="pay-trust__note">{{ section.settings.secure_text }}</p>
      </div>
  </div>
</section>

{% schema %}
{"name": "Alves payment", "settings": [{"type": "product", "id": "product", "label": "Payment product ($1.00 item)"}, {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Secure online payment"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Pay your invoice"}, {"type": "textarea", "id": "text", "label": "Text", "default": "Pay a deposit, a progress payment or your final invoice in seconds."}, {"type": "textarea", "id": "steps", "label": "Steps (one per line)", "default": "Type the amount\nAdd your invoice # (optional)\nTap Pay now and check out securely"}, {"type": "text", "id": "trust_title", "label": "Trust title", "default": "Safe & secure payment"}, {"type": "textarea", "id": "trust_items", "label": "Trust points (Title | detail, one per line)", "default": "PCI DSS Level 1 checkout | The highest standard for card security\n256-bit SSL encryption | Your information is encrypted end to end\nInstant email receipt | Proof of payment sent right away"}, {"type": "text", "id": "secure_text", "label": "Privacy note", "default": "Payments are processed by Shopify Payments. Alves Renovation never sees or stores your full card details."}, {"type": "text", "id": "button_label", "label": "Button label", "default": "Pay now"}, {"type": "text", "id": "button_note", "label": "Note under button", "default": "Secure, encrypted checkout"}, {"type": "checkbox", "id": "show_tips", "label": "Show tip options", "default": true}, {"type": "product", "id": "tip_product", "label": "Tip product ($1.00 item)"}, {"type": "text", "id": "tip_options", "label": "Tip percentages (comma separated)", "default": "10,15,20"}, {"type": "text", "id": "fineprint", "label": "Fine print", "default": "Questions about your invoice? Call or text (267) 616-0381."}, {"type": "text", "id": "unavailable_text", "label": "Message if payments are not set up", "default": "Online payments are not available right now. Please contact us to pay your invoice."}], "presets": [{"name": "Alves payment"}]}
{% endschema %}
