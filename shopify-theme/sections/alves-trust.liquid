<section class="trust">
  <div class="container trust__grid">
    {%- for block in section.blocks -%}<div {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></div>{%- endfor -%}
  </div>
</section>

{% schema %}
{"name": "Alves trust bar", "settings": [], "blocks": [{"type": "item", "name": "Item", "settings": [{"type": "text", "id": "title", "label": "Title", "default": "Title"}, {"type": "text", "id": "text", "label": "Text", "default": "text"}]}], "max_blocks": 4, "presets": [{"name": "Alves trust bar"}]}
{% endschema %}
