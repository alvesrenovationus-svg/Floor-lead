<section class="section">
  <div class="container">
    <header class="section__head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </header>
    <div class="sp-gallery">{%- for block in section.blocks -%}<figure {{ block.shopify_attributes }}>{%- if block.settings.image -%}<img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.caption | strip_html | escape }}" loading="lazy" />{%- endif -%}<figcaption>{{ block.settings.caption }}</figcaption></figure>{%- endfor -%}</div>
  </div>
</section>

{% schema %}
{"name": "Alves photo grid", "settings": [{"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Portfolio"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Recent Work"}], "blocks": [{"type": "photo", "name": "Photo", "settings": [{"type": "image_picker", "id": "image", "label": "Photo"}, {"type": "text", "id": "caption", "label": "Caption"}]}], "presets": [{"name": "Alves photo grid"}]}
{% endschema %}
